#!/usr/bin/env bash

set -euo pipefail

pkg_share="/usr/share/burpsuite-pro"
pkg_agent="${pkg_share}/burpsuite-pro-cn-loader.jar"
pkg_jar="${pkg_share}/burpsuite-pro.jar"

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
workdir="${data_home}/burpsuite-pro-cn"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
configdir="${config_home}/burpsuite-pro-cn"

mkdir -p "${workdir}" "${configdir}"

# 1. 查找兼容的 Java 运行时 (>= 21)
check_java_version() {
  local bin=$1
  [[ -x "${bin}" ]] || return 1
  local ver_str
  ver_str=$("${bin}" -version 2>&1 | head -n1) || return 1
  if [[ ${ver_str} =~ ([0-9]+)(\.[0-9]+)? ]]; then
    local major=${BASH_REMATCH[1]}
    if [[ ${major} == "1" && ${ver_str} =~ 1\.([0-9]+) ]]; then
      major=${BASH_REMATCH[1]}
    fi
    if (( major >= 21 )); then
      return 0
    fi
  fi
  return 1
}

find_java() {
  local candidates=()
  [[ -n "${BURP_PRO_JAVA_BIN:-}" ]] && candidates+=("${BURP_PRO_JAVA_BIN}")
  [[ -n "${BURP_PRO_JAVA_HOME:-}" ]] && candidates+=("${BURP_PRO_JAVA_HOME%/}/bin/java")
  if [[ -f "${configdir}/bp.java" ]]; then
    local custom_home
    read -r custom_home < "${configdir}/bp.java" || true
    [[ -n "${custom_home:-}" ]] && candidates+=("${custom_home%/}/bin/java")
  fi
  [[ -n "${JAVA_HOME:-}" ]] && candidates+=("${JAVA_HOME%/}/bin/java")
  local sys_java
  sys_java="$(command -v java 2>/dev/null || true)"
  [[ -n "${sys_java}" ]] && candidates+=("${sys_java}")
  candidates+=(
    "/usr/lib/jvm/java-27-openjdk/bin/java"
    "/usr/lib/jvm/java-26-openjdk/bin/java"
    "/usr/lib/jvm/java-25-openjdk/bin/java"
    "/usr/lib/jvm/java-21-openjdk/bin/java"
  )

  for cand in "${candidates[@]}"; do
    if check_java_version "${cand}"; then
      printf '%s\n' "${cand}"
      return 0
    fi
  done
  return 1
}

java_bin=""
if ! java_bin="$(find_java)"; then
  echo "burpsuite-pro: 错误: 未找到兼容的 Java 运行时 (需要 Java >= 21)。" >&2
  echo "请安装 jdk21-openjdk 或通过环境变量 JAVA_HOME / BURP_PRO_JAVA_BIN 指定。" >&2
  exit 1
fi

# 2. 构造 JVM 参数
java_opts=(
  --add-opens=java.desktop/javax.swing=ALL-UNNAMED
  --add-opens=java.desktop/java.awt=ALL-UNNAMED
  --add-opens=java.base/java.lang=ALL-UNNAMED
  --add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED
  --add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED
  --add-opens=java.base/jdk.internal.org.objectweb.asm.Opcodes=ALL-UNNAMED
)

if [[ -f "${configdir}/bp.java.options" ]]; then
  while IFS= read -r line; do
    [[ -z "${line}" || "${line}" =~ ^# ]] && continue
    java_opts+=("${line}")
  done < "${configdir}/bp.java.options"
fi

if [[ -n "${BURP_PRO_JAVA_OPTS:-}" ]]; then
  # shellcheck disable=SC2206
  java_opts+=(${BURP_PRO_JAVA_OPTS})
fi

# 3. 解析命令行参数
enable_cn=1
cn_agent_flags="han"
pass_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --english|--no-cn)
      enable_cn=0
      shift
      ;;
    --cn)
      enable_cn=1
      shift
      ;;
    --dump)
      enable_cn=1
      cn_agent_flags="dump"
      shift
      ;;
    --dump=*)
      enable_cn=1
      cn_agent_flags="dump=${1#*=}"
      shift
      ;;
    --)
      shift
      pass_args+=("$@")
      break
      ;;
    -*)
      echo "burpsuite-pro: 错误: 未知选项 '$1'" >&2
      exit 1
      ;;
    *)
      pass_args+=("$1")
      shift
      ;;
  esac
done

cmd=("${java_bin}" "${java_opts[@]}")

# 4. 配置汉化 Agent
if (( enable_cn == 1 )); then
  if [[ ! -f "${pkg_agent}" ]]; then
    echo "burpsuite-pro: 错误: 汉化 Agent 未找到: ${pkg_agent}" >&2
    exit 1
  fi
  cmd+=("-javaagent:${pkg_agent}=${cn_agent_flags}")
fi

if [[ ! -f "${pkg_jar}" ]]; then
  echo "burpsuite-pro: 错误: BurpSuite 主程序未找到: ${pkg_jar}" >&2
  exit 1
fi

cmd+=(-jar "${pkg_jar}")

cd "${workdir}"
exec "${cmd[@]}" "${pass_args[@]}"
